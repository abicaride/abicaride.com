---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalizedPath, ui } from '../i18n/config';

const english = ui.en.notFound;
const spanish = ui.es.notFound;
---

<BaseLayout
  title={`${english.title} · ${spanish.title}`}
  description={`${english.description} ${spanish.description}`}
  locale="en"
  currentLocalePath={getLocalizedPath('en')}
  alternatePath={getLocalizedPath('es')}
  indexable={false}
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="error-intro">
      <p class="error-code" aria-hidden="true">404</p>
      <header>
        <p class="eyebrow">{english.eyebrow}</p>
        <h1 id="not-found-title">
          <span lang="en">{english.heading}</span>
          <span lang="es">{spanish.heading}</span>
        </h1>
      </header>
    </div>

    <div class="language-options">
      <section lang="en" aria-label="English">
        <p>{english.text}</p>
        <a class="arrow-link" href={getLocalizedPath('en')}>{english.action}</a>
      </section>

      <section lang="es" aria-label="Español">
        <p>{spanish.text}</p>
        <a class="arrow-link" href={getLocalizedPath('es')}>{spanish.action}</a>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    max-width: var(--size-content);
    margin-inline: auto;
    padding: var(--space-section) var(--space-page) var(--space-24);
    gap: var(--space-16);
  }

  .error-intro {
    display: grid;
    align-items: end;
    gap: var(--space-8);
  }

  .error-code {
    color: var(--color-surface-strong);
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tight);
  }

  .error-intro header {
    display: grid;
    gap: var(--space-4);
  }

  h1 {
    display: grid;
    max-width: 18ch;
    font-size: var(--font-size-2xl);
    gap: var(--space-3);
  }

  h1 span:last-child {
    color: var(--color-text-muted);
  }

  .language-options {
    display: grid;
    gap: var(--space-8);
  }

  .language-options section {
    display: grid;
    padding-block-start: var(--space-6);
    border-block-start: var(--border-width) solid var(--color-border);
    gap: var(--space-4);
  }

  .language-options p {
    max-width: var(--size-prose);
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .language-options a {
    justify-self: start;
  }

  @media (min-width: 48rem) {
    .error-intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-12);
    }

    .language-options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-12);
    }
  }
</style>
