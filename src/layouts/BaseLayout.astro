---
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import BackToTop from '../components/BackToTop.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { defaultLocale, switchLocalePath, ui, type Locale } from '../i18n/config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  alternatePath?: string;
  currentLocalePath?: string;
  indexable?: boolean;
  headerVariant?: 'default' | 'overlay';
  showBackToTop?: boolean;
}

const { title, description, locale, alternatePath, currentLocalePath, indexable = true, headerVariant = 'default', showBackToTop = true } = Astro.props;
const currentPath = Astro.url.pathname;
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';
const resolvedAlternatePath = alternatePath ?? switchLocalePath(currentPath, otherLocale);
const localizedPaths = { [locale]: currentPath, [otherLocale]: resolvedAlternatePath } as Record<Locale, string>;
const fullTitle = title === ui[locale].siteName ? title : `${title} | ${ui[locale].siteName}`;
const canonicalUrl = new URL(currentPath, Astro.site);
const defaultUrl = new URL(localizedPaths[defaultLocale], Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es_ES'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {indexable && <link rel="canonical" href={canonicalUrl} />}
    {indexable && <link rel="alternate" hreflang="en" href={new URL(localizedPaths.en, Astro.site)} />}
    {indexable && <link rel="alternate" hreflang="es" href={new URL(localizedPaths.es, Astro.site)} />}
    {indexable && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
    <title>{fullTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ui[locale].skipToContent}</a>
    <div class="site-frame">
      <SiteHeader locale={locale} currentPath={currentPath} alternatePath={resolvedAlternatePath} currentLocalePath={currentLocalePath} variant={headerVariant} />
      <main id="main-content">
        {showBackToTop && <span class="back-to-top-trigger" data-back-to-top-trigger aria-hidden="true"></span>}
        <slot />
      </main>
      <SiteFooter locale={locale} />
    </div>
    {showBackToTop && <BackToTop label={ui[locale].backToTop} />}
    <AnalyticsConsent locale={locale} />
  </body>
</html>

<style>
  .site-frame { position: relative; display: grid; min-height: 100vh; grid-template-rows: auto 1fr auto; }
  #main-content { position: relative; }
  .back-to-top-trigger { position: absolute; inset-block-start: 50vh; inline-size: var(--border-width); block-size: var(--border-width); pointer-events: none; }
</style>
