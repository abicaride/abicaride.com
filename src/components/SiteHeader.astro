---
import { getLocalizedPath, getWritingIndexPath, languageNames, switchLocalePath, ui, type Locale } from '../i18n/config';
import brandMarkSvg from '../assets/brand/abilene-mark.svg?raw';
import ThemeControl from './ThemeControl.astro';

interface Props {
  locale: Locale;
  currentPath: string;
  alternatePath?: string;
  currentLocalePath?: string;
  variant?: 'default' | 'overlay';
}

const { locale, currentPath, alternatePath, currentLocalePath, variant = 'default' } = Astro.props;
const copy = ui[locale];
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';
const languagePath = alternatePath ?? switchLocalePath(currentPath, otherLocale);
const localePaths = {
  [locale]: currentLocalePath ?? currentPath,
  [otherLocale]: languagePath,
} as Record<Locale, string>;
const normalizePath = (path: string) => path.replace(/\/+$/, '') || '/';
const normalizedCurrentPath = normalizePath(currentPath);
const homePath = getLocalizedPath(locale);
const navigation = [
  { label: copy.nav.projects, href: getLocalizedPath(locale, 'projects') },
  { label: copy.nav.writing, href: getWritingIndexPath(locale) },
  { label: copy.nav.about, href: getLocalizedPath(locale, 'about') },
  { label: copy.nav.contact, href: getLocalizedPath(locale, 'contact') },
];
const isActive = (href: string) => {
  const normalizedHref = normalizePath(href);
  return normalizedCurrentPath === normalizedHref || (normalizedHref !== normalizePath(homePath) && normalizedCurrentPath.startsWith(`${normalizedHref}/`));
};
---

<header class:list={['site-header', variant]} data-site-header data-menu-open="false">
  <div class="header-inner">
    <a class="brand" href={getLocalizedPath(locale)}>
      <span class="brand-logo" aria-hidden="true" set:html={brandMarkSvg}></span>
      <span>{copy.siteName}</span>
    </a>
    <button
      class="mobile-menu-toggle"
      type="button"
      aria-label={copy.mobileNavigation.open}
      aria-expanded="false"
      aria-controls={`site-navigation-${locale}`}
      data-menu-toggle
      data-label-open={copy.mobileNavigation.open}
      data-label-close={copy.mobileNavigation.close}
    >
      <span class="menu-icon" aria-hidden="true"><span></span></span>
    </button>
    <div class="navigation-panel" id={`site-navigation-${locale}`} data-navigation-panel>
      <nav class="primary-nav" aria-label={copy.primaryNavigation}>
        <ul>
          {navigation.map((item) => <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div class="header-actions">
        <nav class="language-nav" aria-label={copy.languageNavigation}>
          <a href={localePaths.en} lang="en" hreflang={locale === 'en' ? undefined : 'en'} aria-current={locale === 'en' ? 'page' : undefined}><span class="visually-hidden">{languageNames.en}</span>EN</a>
          <span aria-hidden="true">/</span>
          <a href={localePaths.es} lang="es" hreflang={locale === 'es' ? undefined : 'es'} aria-current={locale === 'es' ? 'page' : undefined}><span class="visually-hidden">{languageNames.es}</span>ES</a>
        </nav>
        <ThemeControl labels={copy.theme} />
      </div>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-site-header]').forEach((header) => {
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const panel = header.querySelector<HTMLElement>('[data-navigation-panel]');

    if (!toggle || !panel) return;

    const setOpen = (open: boolean, returnFocus = false) => {
      header.dataset.menuOpen = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? toggle.dataset.labelClose ?? '' : toggle.dataset.labelOpen ?? '');

      if (!open && returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false, true);
    });

    const mobileViewport = window.matchMedia('(max-width: 46rem)');
    const closeAtDesktop = (event: MediaQueryListEvent) => {
      if (!event.matches) setOpen(false);
    };

    mobileViewport.addEventListener('change', closeAtDesktop);
  });
</script>

<style>
  .site-header { position: relative; z-index: 10; border-block-end: var(--border-width) solid var(--color-border); background: var(--color-canvas); }
  .site-header.overlay { position: absolute; inset: 0 0 auto; border-color: color-mix(in srgb, var(--color-canvas) 28%, transparent); background: transparent; }
  .header-inner { display: flex; min-height: var(--size-header); max-width: var(--size-wide); margin-inline: auto; padding: var(--space-5) var(--space-page); align-items: center; gap: var(--space-4) var(--space-8); }
  .brand { display: inline-flex; min-height: 2.75rem; margin-inline-end: auto; align-items: center; gap: var(--space-2); color: var(--color-green-deep); font-family: var(--font-heading); font-size: clamp(1.35rem, 1.1rem + 0.8vw, 2rem); font-weight: var(--font-weight-medium); letter-spacing: var(--letter-spacing-tight); text-decoration: none; white-space: nowrap; }
  .brand-logo { display: block; width: 2.125rem; height: 2.125rem; flex: none; color: inherit; }
  .brand-logo :global(svg) { display: block; width: 100%; height: 100%; }
  .brand-logo :global(path) { fill: currentColor; }
  :global(html[data-theme='light']) .brand-logo { color: var(--color-green-deep); }
  .navigation-panel { display: contents; }
  ul { display: flex; margin: 0; padding: 0; align-items: center; gap: clamp(var(--space-4), 3vw, var(--space-8)); list-style: none; }
  nav a { display: inline-flex; min-height: 2.75rem; align-items: center; color: var(--color-green-deep); font-family: var(--font-heading); font-size: var(--font-size-sm); font-weight: var(--font-weight-medium); text-decoration: none; }
  nav a:hover, nav a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 0.12rem; text-underline-offset: 0.4rem; }
  .header-actions { display: flex; align-items: center; gap: var(--space-2); }
  .language-nav { display: flex; align-items: center; gap: var(--space-2); color: var(--color-ink-muted); }
  .language-nav a { min-width: 2.75rem; justify-content: center; font-size: var(--font-size-xs); letter-spacing: 0.04em; }
  .overlay .brand { color: var(--color-overlay-text); text-shadow: 0 1px 16px color-mix(in srgb, var(--color-overlay-shadow) 78%, transparent); }
  .overlay .brand-logo { filter: drop-shadow(0 1px 16px color-mix(in srgb, var(--color-overlay-shadow) 78%, transparent)); }
  .overlay .primary-nav a, .overlay .language-nav, .overlay .language-nav a { color: var(--color-overlay-text); text-shadow: 0 1px 16px color-mix(in srgb, var(--color-overlay-shadow) 78%, transparent); }
  .overlay :focus-visible { outline-color: var(--color-overlay-text); }
  .mobile-menu-toggle { display: none; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (max-width: 46rem) {
    .site-header.overlay { position: relative; inset: auto; border-color: var(--color-border); background: var(--color-canvas); }
    .header-inner { display: grid; min-height: 4.75rem; padding-block: var(--space-3); grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 0 var(--space-4); }
    .brand { min-width: 0; font-size: 1.45rem; }
    .brand-logo { width: 1.75rem; height: 1.75rem; }
    .mobile-menu-toggle {
      display: inline-grid;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0;
      border: 0;
      place-items: center;
      background: transparent;
      color: var(--color-green-deep);
      cursor: pointer;
    }
    .menu-icon, .menu-icon::before, .menu-icon::after, .menu-icon span {
      display: block;
      width: 1.5rem;
      height: 0.125rem;
      background: currentColor;
      transition: transform 140ms ease, opacity 140ms ease;
    }
    .menu-icon { position: relative; background: transparent; }
    .menu-icon::before, .menu-icon::after { position: absolute; inset-inline-start: 0; content: ''; }
    .menu-icon::before { transform: translateY(-0.4rem); }
    .menu-icon::after { transform: translateY(0.4rem); }
    .site-header[data-menu-open='true'] .menu-icon span { opacity: 0; }
    .site-header[data-menu-open='true'] .menu-icon::before { transform: rotate(45deg); }
    .site-header[data-menu-open='true'] .menu-icon::after { transform: rotate(-45deg); }
    .navigation-panel {
      display: none;
      width: calc(100% + (var(--space-page) * 2));
      margin-block-start: var(--space-3);
      margin-inline: calc(var(--space-page) * -1);
      padding: var(--space-4) var(--space-page) var(--space-3);
      border-block-start: var(--border-width) solid var(--color-border);
      grid-column: 1 / -1;
      background: var(--color-canvas);
    }
    .site-header[data-menu-open='true'] .navigation-panel { display: block; }
    .primary-nav ul { display: grid; justify-content: stretch; gap: 0; }
    .primary-nav a { width: 100%; min-height: 3rem; font-size: var(--font-size-md); }
    .header-actions { margin-block-start: var(--space-3); padding-block-start: var(--space-3); justify-content: space-between; }
    .site-header.overlay .brand,
    .site-header.overlay .mobile-menu-toggle,
    .site-header.overlay .primary-nav a,
    .site-header.overlay .language-nav,
    .site-header.overlay .language-nav a { color: var(--color-green-deep); text-shadow: none; }
    .site-header.overlay .brand-logo { filter: none; }
    .site-header.overlay :focus-visible { outline-color: var(--color-focus); }
  }

  @media (max-width: 46rem) and (prefers-reduced-motion: reduce) {
    .menu-icon, .menu-icon::before, .menu-icon::after, .menu-icon span { transition: none; }
  }
</style>
