---
import { pageSeo } from '../../data/seo';
import { getWritingArticlePath, getWritingIndexPath, ui, type Locale } from '../../i18n/config';
import { formatWritingDate, getWritingForIndex, getWritingEditorPath } from '../../lib/writing';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LineIcon from '../LineIcon.astro';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const copy = ui[locale];
const seo = pageSeo[locale].writing;
const articles = await getWritingForIndex(locale);
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  locale={locale}
  alternatePath={getWritingIndexPath(otherLocale)}
>
  <div class="writing-shell">
    <header class="page-header">
      <div class="page-heading">
        <h1>{copy.writing.title}</h1>
        {import.meta.env.DEV && (
          <a class="editor-link" href="/admin/index.html#/collections/writing" aria-label={copy.writing.openEditorLabel}>
            <LineIcon name="writing" size={28} />
          </a>
        )}
      </div>
      <p>{copy.writing.description}</p>
    </header>

    {articles.length > 0 ? (
      <ol class="writing-list">
        {articles.map((article) => (
          <li>
            <article class="writing-preview">
              <div class="article-meta">
                {article.data.category && <span>{article.data.category}</span>}
                {article.data.category && <span aria-hidden="true">·</span>}
                <time datetime={article.data.publishedAt.toISOString()}>
                  {formatWritingDate(article.data.publishedAt, locale)}
                </time>
              </div>
              <div class="preview-heading">
                <h2>
                  <a href={getWritingArticlePath(locale, article.data.routeSlug)}>
                    {article.data.title}
                  </a>
                  {import.meta.env.DEV && !article.data.published && (
                    <strong class="draft-label">({copy.writing.draftLabel})</strong>
                  )}
                </h2>
                {import.meta.env.DEV && (
                  <a
                    class="entry-edit-link"
                    href={getWritingEditorPath(article, locale)}
                    aria-label={`${copy.writing.editArticle}: ${article.data.title}`}
                  >
                    <LineIcon name="writing" size={26} />
                  </a>
                )}
              </div>
              <p>{article.data.description}</p>
              <a class="arrow-link" href={getWritingArticlePath(locale, article.data.routeSlug)}>
                {copy.writing.readArticle}
              </a>
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty-state">{copy.writing.empty}</p>
    )}
  </div>
</BaseLayout>

<style>
  .writing-shell { display: grid; width: min(100%, var(--size-content)); margin-inline: auto; padding: var(--space-section) var(--space-page); gap: var(--space-section); }
  .page-header { display: grid; max-width: var(--size-prose); gap: var(--space-5); }
  .page-heading { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .page-header h1 { font-size: var(--font-size-3xl); }
  .page-header p { color: var(--color-ink-muted); font-size: var(--font-size-lg); }
  .editor-link { display: inline-grid; width: var(--space-10); height: var(--space-10); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-sm); place-items: center; color: var(--color-ink); text-decoration: none; }
  .editor-link:hover { border-color: var(--color-green-deep); background: var(--color-green-tint); color: var(--color-green-deep); }
  .writing-list { display: grid; max-width: var(--size-narrow); margin: 0; padding: 0; list-style: none; }
  .writing-list > li { border-block-start: var(--border-width) solid var(--color-border); }
  .writing-list > li:last-child { border-block-end: var(--border-width) solid var(--color-border); }
  .writing-preview { display: grid; padding-block: clamp(var(--space-8), 6vw, var(--space-12)); gap: var(--space-4); }
  .article-meta { display: flex; color: var(--color-ink-muted); font-size: var(--font-size-sm); gap: var(--space-2); flex-wrap: wrap; }
  .draft-label { margin-inline-start: var(--space-2); color: var(--color-ink); font-size: var(--font-size-md); font-weight: var(--font-weight-semibold); white-space: nowrap; }
  .preview-heading { display: block; }
  .writing-preview h2 { font-size: clamp(1.75rem, 1.45rem + 1.2vw, 2.75rem); }
  .preview-heading h2 { display: inline; }
  .writing-preview h2 a { color: var(--color-ink); text-decoration: none; }
  .writing-preview h2 a:hover { color: var(--color-green-deep); text-decoration: underline; text-underline-offset: .16em; }
  .entry-edit-link { display: inline-grid; width: var(--space-10); height: var(--space-10); margin-inline-start: var(--space-3); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-sm); place-items: center; vertical-align: middle; color: var(--color-ink); text-decoration: none; }
  .entry-edit-link:hover { border-color: var(--color-green-deep); background: var(--color-green-tint); color: var(--color-green-deep); }
  .writing-preview > p { max-width: var(--size-prose); color: var(--color-ink-muted); font-size: var(--font-size-md); }
  .writing-preview .arrow-link { justify-self: start; font-size: var(--font-size-sm); }
  .empty-state { max-width: var(--size-prose); padding-block: var(--space-8); border-block: var(--border-width) solid var(--color-border); color: var(--color-ink-muted); font-size: var(--font-size-md); }
</style>
