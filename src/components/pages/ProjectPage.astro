---
import { render, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { getLocalizedPath, ui, type Locale } from '../../i18n/config';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props { locale: Locale; project: CollectionEntry<'projects'>; alternatePath?: string; }
const { locale, project, alternatePath } = Astro.props;
const copy = ui[locale];
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description} locale={locale} alternatePath={alternatePath}>
  <article class="project-shell">
    <a class="back-link" href={getLocalizedPath(locale, 'projects')}><span aria-hidden="true">← </span>{copy.project.back}</a>
    <header class="project-header">
      <p class="project-meta"><span>{project.data.category}</span>{project.data.year && <><span aria-hidden="true">·</span><span>{project.data.year}</span></>}</p>
      <h1>{project.data.title}</h1>
      <p class="lede">{project.data.description}</p>
      <ul class="tags" aria-label={locale === 'en' ? 'Topics' : 'Temas'}>{project.data.tags.map((tag) => <li>{tag}</li>)}</ul>
    </header>
    <figure class="project-image">
      <Picture
        src={project.data.image.src}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 78rem) 1184px, calc(100vw - 32px)"
        quality={75}
        alt={project.data.image.alt}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </figure>
    <div class="project-body"><Content /></div>
    {project.data.externalUrl && (
      <aside class="project-link">
        <p>{locale === 'en' ? 'Want to see the source material?' : '¿Quieres ver el material original?'}</p>
        <a class="arrow-link" href={project.data.externalUrl} target="_blank" rel="noreferrer">{project.data.externalLabel ?? copy.project.visit}</a>
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .project-shell { display: grid; max-width: var(--size-content); margin-inline: auto; padding: var(--space-section) var(--space-page) var(--space-24); gap: var(--space-8); }
  .back-link { justify-self: start; }
  .project-header { display: grid; max-width: 60rem; gap: var(--space-5); }
  .project-header h1 { font-size: var(--font-size-2xl); overflow-wrap: anywhere; }
  .lede { max-width: var(--size-prose); color: var(--color-text-muted); font-size: var(--font-size-lg); }
  .project-meta { display: flex; color: var(--color-accent); font-size: var(--font-size-sm); font-weight: var(--font-weight-medium); gap: var(--space-2); }
  .tags { display: flex; padding: 0; gap: var(--space-2); flex-wrap: wrap; list-style: none; }
  .tags li { padding: var(--space-1) var(--space-3); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-pill); color: var(--color-text-muted); font-size: var(--font-size-sm); }
  .project-image { margin: var(--space-4) 0; }
  .project-image img { width: 100%; height: auto; max-height: 46rem; border-radius: var(--radius-lg); background: var(--color-surface); object-fit: cover; }
  .project-body { display: grid; max-width: var(--size-prose); gap: var(--space-4); }
  .project-body :global(h2) { margin-block-start: var(--space-8); }
  .project-body :global(h3) { margin-block-start: var(--space-6); }
  .project-body :global(ul), .project-body :global(ol) { display: grid; padding-inline-start: var(--space-6); gap: var(--space-2); }
  .project-body :global(a) { overflow-wrap: anywhere; }
  .project-link { display: grid; max-width: var(--size-prose); margin-block-start: var(--space-4); padding: var(--space-8); border-radius: var(--radius-lg); background: var(--color-surface); gap: var(--space-3); }
  .project-link .arrow-link { justify-self: start; }
</style>
