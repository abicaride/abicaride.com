---
import { render, type CollectionEntry } from 'astro:content';
import { getLocalizedPath, ui, type Locale } from '../../i18n/config';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
  project: CollectionEntry<'projects'>;
  alternatePath?: string;
}

const { locale, project, alternatePath } = Astro.props;
const copy = ui[locale];
const { Content } = await render(project);
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  locale={locale}
  alternatePath={alternatePath}
>
  <article class="project-shell">
    <a class="back-link" href={getLocalizedPath(locale, 'projects')}>
      <span aria-hidden="true">← </span>{copy.project.back}
    </a>

    <header class="project-header">
      <h1>{project.data.title}</h1>
      <p class="lede">{project.data.description}</p>
      <p class="project-meta">
        <time datetime={project.data.publishedAt.toISOString()}>
          {project.data.publishedAt.getFullYear()}
        </time>
        <span aria-hidden="true">·</span>
        <span>{copy.project[project.data.status]}</span>
      </p>
    </header>

    <div class="project-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-shell {
    display: grid;
    max-width: var(--size-content);
    margin-inline: auto;
    padding: var(--space-section) var(--space-page);
    gap: var(--space-8);
  }

  .back-link {
    justify-self: start;
  }

  .project-header,
  .project-body {
    display: grid;
    max-width: var(--size-prose);
    gap: var(--space-4);
  }

  .lede {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .project-meta {
    display: flex;
    color: var(--color-text-muted);
    gap: var(--space-2);
    font-size: var(--font-size-sm);
  }

  .project-body {
    padding-block-start: var(--space-8);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .project-body :global(h2),
  .project-body :global(h3) {
    margin-block-start: var(--space-6);
  }

  .project-body :global(ul),
  .project-body :global(ol) {
    padding-inline-start: var(--space-6);
  }
</style>
