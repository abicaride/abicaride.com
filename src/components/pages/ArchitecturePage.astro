---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { architectureCopy } from '../../data/architecture';
import { getLocalizedPath, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = architectureCopy[locale];
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';
const alternatePath = getLocalizedPath(otherLocale, otherLocale === 'en' ? 'architecture' : 'arquitectura');
const architectureDocumentUrl = 'https://github.com/abicaride/abicaride.com/blob/main/docs/ARCHITECTURE.md';
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  locale={locale}
  alternatePath={alternatePath}
>
  <article class="architecture-shell">
    <header class="architecture-header">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <p class="lede">{copy.introduction}</p>
    </header>

    <section class="flow" aria-labelledby="flow-title">
      <h2 id="flow-title">{copy.flowTitle}</h2>
      <ol>
        {copy.flow.map((step) => (
          <li>
            <span class="step-icon" aria-hidden="true">{step.icon}</span>
            <div>
              <h3>{step.name}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <div class="details-grid">
      <section aria-labelledby="collaboration-title">
        <h2 id="collaboration-title">{copy.collaborationTitle}</h2>
        <p>{copy.collaborationText}</p>
      </section>

      <section aria-labelledby="principles-title">
        <h2 id="principles-title">{copy.principlesTitle}</h2>
        <ul>
          {copy.principles.map((principle) => <li>{principle}</li>)}
        </ul>
      </section>
    </div>

    <aside class="source-note">
      <div>
        <h2>{copy.sourceTitle}</h2>
        <p>{copy.sourceText}</p>
      </div>
      <a href={architectureDocumentUrl} target="_blank" rel="noreferrer">
        {copy.sourceLink}<span aria-hidden="true"> ↗</span>
      </a>
    </aside>
  </article>
</BaseLayout>

<style>
  .architecture-shell {
    display: grid;
    max-width: var(--size-content);
    margin-inline: auto;
    padding: var(--space-section) var(--space-page) var(--space-24);
    gap: var(--space-16);
  }

  .architecture-header {
    display: grid;
    max-width: var(--size-narrow);
    gap: var(--space-5);
  }

  .architecture-header h1 {
    max-width: 14ch;
  }

  .lede {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .flow {
    display: grid;
    gap: var(--space-8);
  }

  .flow ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    padding-block: var(--space-5);
    border-block-start: var(--border-width) solid var(--color-border);
    gap: var(--space-4);
  }

  .step-icon {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-tight);
  }

  .flow li div,
  .details-grid section,
  .source-note div {
    display: grid;
    gap: var(--space-2);
  }

  .flow h3 {
    font-size: var(--font-size-md);
  }

  .flow p,
  .details-grid p,
  .details-grid li,
  .source-note p {
    color: var(--color-text-muted);
  }

  .details-grid {
    display: grid;
    gap: var(--space-12);
  }

  .details-grid section {
    align-content: start;
    gap: var(--space-4);
  }

  .details-grid h2,
  .source-note h2 {
    font-size: var(--font-size-lg);
  }

  .details-grid ul {
    display: grid;
    margin: 0;
    padding-inline-start: var(--space-5);
    gap: var(--space-3);
  }

  .source-note {
    display: grid;
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    gap: var(--space-6);
  }

  .source-note a {
    justify-self: start;
    font-weight: var(--font-weight-medium);
  }

  @media (min-width: 48rem) {
    .flow ol,
    .details-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-8);
    }

    .source-note {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }
</style>
