---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import heroImage from '../../assets/images/abilene-hero-v2.png';
import { pageSeo } from '../../data/seo';
import { getLocalizedPath, ui, type Locale } from '../../i18n/config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPreview from '../ProjectPreview.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = ui[locale];
const seo = pageSeo[locale].home;
const projects = (await getCollection('projects', ({ data }) => data.locale === locale && data.featured && !data.draft)).sort((a, b) => a.data.order - b.data.order);
const leadProject = projects.find((project) => project.data.translationKey === 'imaginart-b2b-content');
---

<BaseLayout title={seo.title} description={seo.description} locale={locale} headerVariant="overlay" showBackToTop profilePage>
  <section class="hero" aria-labelledby="page-title">
    <Picture
      class="hero-picture"
      src={heroImage}
      formats={['avif', 'webp']}
      fallbackFormat="png"
      widths={[640, 900, 1200, 1600, 2048]}
      sizes="100vw"
      quality={82}
      alt={copy.home.heroAlt}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow role">{copy.home.title}</p>
        <h1 id="page-title">{copy.home.heroHeading}</h1>
        <p class="hero-supporting">{copy.home.heroSupporting}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#selected-work">{copy.home.projectsLink}<span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="mailto:abicaride@gmail.com">{copy.home.contactLink}<span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <div class="home-content">
    {leadProject && (
      <section class="lead-work" id="selected-work" aria-labelledby="lead-title">
        <header class="section-heading">
          <p class="eyebrow">{copy.home.leadEyebrow}</p>
          <h2 id="lead-title">{copy.home.leadTitle}</h2>
          <p>{copy.home.leadSummary}</p>
        </header>
        <ProjectPreview project={leadProject} locale={locale} variant="lead" />
      </section>
    )}

    <section class="capabilities" aria-labelledby="capabilities-title">
      <header class="section-heading compact-heading">
        <p class="eyebrow">{copy.home.capabilitiesEyebrow}</p>
        <h2 id="capabilities-title">{copy.home.capabilitiesTitle}</h2>
      </header>
      <div class="capability-list">
        {copy.home.capabilities.map((capability) => (
          <article class="capability">
            <h3>{capability.title}</h3>
            <p>{capability.text}</p>
          </article>
        ))}
      </div>
      <a class="arrow-link all-work" href={getLocalizedPath(locale, 'projects')}>{copy.home.allProjectsLink}</a>
    </section>
  </div>

  <section class="about-intro" aria-labelledby="about-title">
    <div>
      <p class="eyebrow">{copy.home.aboutEyebrow}</p>
      <h2 id="about-title">{copy.home.aboutTitle}</h2>
    </div>
    <div class="about-copy">
      <p>{copy.home.aboutText}</p>
      <a class="arrow-link" href={getLocalizedPath(locale, 'about')}>{copy.home.aboutLink}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; background: var(--color-canvas); }
  .hero :global(.hero-picture) { display: block; width: 100%; height: auto; object-fit: contain; object-position: center top; }
  .hero-inner { position: relative; z-index: 1; max-width: var(--size-wide); margin-inline: auto; padding: var(--space-8) var(--space-page) var(--space-16); }
  .hero-copy { display: grid; width: min(100%, 44rem); gap: var(--space-4); }
  h1 { color: var(--color-green-deep); font-size: min(var(--font-size-2xl), 9vw); }
  .role { color: var(--color-green-deep); }
  .hero-supporting { max-width: 54ch; color: var(--color-ink-muted); font-size: var(--font-size-md); }
  .hero-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .home-content { display: grid; max-width: var(--size-content); margin-inline: auto; padding: var(--space-section) var(--space-page); gap: var(--space-section); }
  .lead-work, .capabilities { display: grid; gap: var(--space-10); }
  .section-heading { display: grid; max-width: 54rem; gap: var(--space-4); }
  .section-heading > p:last-child { max-width: var(--size-prose); color: var(--color-ink-muted); font-size: var(--font-size-md); }
  .compact-heading { max-width: 48rem; }
  .capability-list { border-block-end: var(--border-width) solid var(--color-border); }
  .capability { display: grid; padding-block: var(--space-8); border-block-start: var(--border-width) solid var(--color-border); gap: var(--space-4); }
  .capability h3 { font-size: clamp(1.4rem, 1.2rem + .7vw, 2rem); }
  .capability p { max-width: var(--size-prose); color: var(--color-ink-muted); font-size: var(--font-size-md); }
  .all-work { justify-self: start; }
  .about-intro { display: grid; padding: var(--space-section) max(var(--space-page), calc((100vw - var(--size-content)) / 2 + var(--space-page))); background: var(--color-surface); gap: var(--space-10); }
  .about-intro > div { display: grid; align-content: start; gap: var(--space-4); }
  .about-intro h2 { max-width: 18ch; }
  .about-copy p { max-width: var(--size-prose); color: var(--color-ink-muted); font-size: var(--font-size-md); }
  .about-copy .arrow-link { justify-self: start; }

  @media (min-width: 48rem) {
    .hero { min-height: clamp(48rem, 65vw, 58rem); }
    .hero :global(.hero-picture) { position: absolute; inset: 0; height: 100%; object-fit: cover; object-position: 58% center; }
    .hero-inner { display: flex; min-height: inherit; padding-block-start: calc(var(--size-header) + var(--space-16)); align-items: center; }
    .hero-copy { width: min(52%, 45rem); }
    .capability { grid-template-columns: minmax(12rem, .7fr) minmax(0, 1.3fr); align-items: start; gap: var(--space-12); }
    .about-intro { grid-template-columns: minmax(0, .9fr) minmax(20rem, 1.1fr); gap: var(--space-16); }
  }

  @media (min-width: 80rem) {
    .hero :global(.hero-picture) { object-position: center; }
  }
</style>
