---
import { getCollection } from 'astro:content';
import { pageSeo } from '../../data/seo';
import { ui, type Locale } from '../../i18n/config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPreview from '../ProjectPreview.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = ui[locale];
const seo = pageSeo[locale].projects;
const projects = (await getCollection('projects', ({ data }) => data.locale === locale && !data.draft)).sort((a, b) => a.data.order - b.data.order);
const selected = projects.filter((project) => project.data.featured);
const lead = selected.find((project) => project.data.translationKey === 'imaginart-b2b-content');
const secondary = selected.filter((project) => project !== lead);
const more = projects.filter((project) => !project.data.featured);
---

<BaseLayout title={seo.title} description={seo.description} locale={locale}>
  <div class="projects-shell">
    <header class="page-header">
      <p class="eyebrow">{copy.projects.selectedEyebrow}</p>
      <h1>{copy.projects.title}</h1>
      <p>{copy.projects.description}</p>
    </header>

    {projects.length ? (
      <>
        <section class="selected" aria-labelledby="selected-heading">
          <h2 id="selected-heading">{copy.projects.selectedTitle}</h2>
          {lead && <ProjectPreview project={lead} locale={locale} variant="lead" />}
          <div class="secondary-grid">{secondary.map((project) => <ProjectPreview project={project} locale={locale} variant="secondary" />)}</div>
        </section>
        <section class="more" aria-labelledby="more-heading">
          <header><p class="eyebrow">{copy.projects.moreEyebrow}</p><h2 id="more-heading">{copy.projects.moreTitle}</h2></header>
          <div class="more-list">{more.map((project) => <ProjectPreview project={project} locale={locale} variant="compact" />)}</div>
        </section>
      </>
    ) : <p>{copy.projects.empty}</p>}
  </div>
</BaseLayout>

<style>
  .projects-shell { display: grid; max-width: var(--size-content); margin-inline: auto; padding: var(--space-section) var(--space-page); gap: var(--space-section); }
  .page-header { display: grid; max-width: 54rem; gap: var(--space-5); }
  .page-header h1 { font-size: var(--font-size-3xl); }
  .page-header > p:last-child { max-width: var(--size-prose); color: var(--color-ink-muted); font-size: var(--font-size-lg); }
  .selected, .more { display: grid; gap: var(--space-10); }
  .selected > h2, .more header { max-width: 44rem; }
  .secondary-grid { display: grid; gap: var(--space-16) var(--space-8); }
  .more { padding-block-start: var(--space-12); border-block-start: var(--border-width) solid var(--color-border); }
  .more header { display: grid; gap: var(--space-3); }
  .more-list { display: grid; }

  @media (min-width: 48rem) {
    .secondary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .more-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-12); }
  }
</style>
