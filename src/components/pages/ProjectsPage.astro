---
import { getCollection } from 'astro:content';
import { ui, type Locale } from '../../i18n/config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPreview from '../ProjectPreview.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = ui[locale];
const projects = (await getCollection('projects', ({ data }) => data.locale === locale && !data.draft)).sort((a, b) => a.data.order - b.data.order);
const selected = projects.filter((project) => project.data.featured);
const more = projects.filter((project) => !project.data.featured);
---

<BaseLayout title={copy.projects.title} description={copy.projects.description} locale={locale}>
  <div class="projects-shell">
    <header class="page-header">
      <p class="eyebrow">{copy.projects.selectedEyebrow}</p>
      <h1>{copy.projects.title}</h1>
      <p>{copy.projects.description}</p>
    </header>
    {projects.length ? (
      <>
        <section class="selected" aria-labelledby="selected-heading">
          <h2 id="selected-heading">{copy.projects.selectedTitle}</h2>
          <div class="selected-grid">{selected.map((project, index) => <ProjectPreview project={project} locale={locale} wide={index === 0} />)}</div>
        </section>
        <section class="more" aria-labelledby="more-heading">
          <header><p class="eyebrow">{copy.projects.moreEyebrow}</p><h2 id="more-heading">{copy.projects.moreTitle}</h2></header>
          <div class="more-list">{more.map((project) => <ProjectPreview project={project} locale={locale} compact />)}</div>
        </section>
      </>
    ) : <p>{copy.projects.empty}</p>}
  </div>
</BaseLayout>

<style>
  .projects-shell { display: grid; max-width: var(--size-content); margin-inline: auto; padding: var(--space-section) var(--space-page) var(--space-24); gap: var(--space-20); }
  .page-header { display: grid; max-width: 48rem; gap: var(--space-4); }
  .page-header h1 { font-size: var(--font-size-3xl); }
  .page-header > p:last-child { color: var(--color-text-muted); font-size: var(--font-size-lg); }
  .selected, .more { display: grid; gap: var(--space-8); }
  .selected > h2, .more header { max-width: 36rem; }
  .selected-grid { display: grid; gap: var(--space-12) var(--space-6); }
  .more header { display: grid; gap: var(--space-3); }
  .more-list { display: grid; }
  @media (min-width: 45rem) {
    .selected-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .selected-grid :global(article:first-child) { grid-column: 1 / -1; }
    .more-list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-8); }
  }
</style>
