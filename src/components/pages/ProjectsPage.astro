---
import { getCollection } from 'astro:content';
import { getLocalizedPath, ui, type Locale } from '../../i18n/config';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const projects = (await getCollection('projects', ({ data }) => data.locale === locale && !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title={copy.projects.title} description={copy.projects.description} locale={locale}>
  <div class="projects-shell">
    <header class="page-header">
      <h1>{copy.projects.title}</h1>
      <p>{copy.projects.description}</p>
    </header>

    {projects.length > 0 ? (
      <ol class="project-list">
        {projects.map((project) => (
          <li>
            <article class="project-summary">
              <div class="project-copy">
                <h2>{project.data.title}</h2>
                <p>{project.data.description}</p>
              </div>
              <dl class="project-meta">
                <div>
                  <dt>{copy.projects.year}</dt>
                  <dd>{project.data.publishedAt.getFullYear()}</dd>
                </div>
                <div>
                  <dt>{copy.projects.status}</dt>
                  <dd>{copy.project[project.data.status]}</dd>
                </div>
              </dl>
              <a href={getLocalizedPath(locale, `projects/${project.data.slug}`)}>
                {copy.projects.readProject}<span aria-hidden="true"> →</span>
              </a>
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <p>{copy.projects.empty}</p>
    )}
  </div>
</BaseLayout>

<style>
  .projects-shell {
    display: grid;
    max-width: var(--size-content);
    margin-inline: auto;
    padding: var(--space-section) var(--space-page);
    gap: var(--space-12);
  }

  .page-header,
  .project-copy {
    display: grid;
    max-width: var(--size-prose);
    gap: var(--space-3);
  }

  .page-header p,
  .project-copy p {
    color: var(--color-text-muted);
  }

  .project-list {
    display: grid;
    margin: 0;
    padding: 0;
    gap: var(--space-6);
    list-style: none;
  }

  .project-summary {
    display: grid;
    padding-block: var(--space-6);
    border-block-start: var(--border-width) solid var(--color-border);
    gap: var(--space-6);
  }

  .project-meta {
    display: flex;
    gap: var(--space-8);
  }

  .project-meta div {
    display: grid;
    gap: var(--space-1);
  }

  dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  dd {
    margin: 0;
  }

  .project-summary > a {
    justify-self: start;
    font-weight: var(--font-weight-medium);
  }
</style>
