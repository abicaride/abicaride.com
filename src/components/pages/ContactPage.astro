---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
---

<BaseLayout title={copy.contact.title} description={copy.contact.description} locale={locale}>
  <section class="contact-shell" aria-labelledby="contact-title">
    <p class="eyebrow">{copy.contact.eyebrow}</p>
    <h1 id="contact-title">{copy.contact.heading}</h1>
    <p class="lede">{copy.contact.introduction}</p>
    <div class="contact-links">
      <a href="mailto:abicaride@gmail.com">{copy.contact.emailLabel}<span aria-hidden="true"> ↗</span></a>
      <a href="https://www.linkedin.com/in/abilene-caride/" target="_blank" rel="noreferrer">
        {copy.contact.linkedinLabel}<span aria-hidden="true"> ↗</span>
      </a>
    </div>
    <p class="location">{copy.contact.location}</p>
  </section>
</BaseLayout>

<style>
  .contact-shell {
    display: grid;
    max-width: var(--size-content);
    margin-inline: auto;
    padding: var(--space-section) var(--space-page) var(--space-24);
    gap: var(--space-6);
  }

  h1 {
    max-width: 12ch;
  }

  .lede {
    max-width: var(--size-prose);
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }

  .contact-links {
    display: grid;
    margin-block-start: var(--space-6);
    border-block-start: var(--border-width) solid var(--color-border);
  }

  .contact-links a {
    display: flex;
    padding-block: var(--space-4);
    border-block-end: var(--border-width) solid var(--color-border);
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    justify-content: space-between;
    text-decoration: none;
  }

  .contact-links a:hover {
    color: var(--color-accent);
  }

  .location {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
