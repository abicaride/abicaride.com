---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { getLocalizedPath, ui, type Locale } from '../i18n/config';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
  compact?: boolean;
  wide?: boolean;
}

const { project, locale, compact = false, wide = false } = Astro.props;
const copy = ui[locale];
const sizes = wide
  ? '(min-width: 78rem) 1184px, calc(100vw - 64px)'
  : '(min-width: 78rem) 580px, (min-width: 45rem) calc(50vw - 44px), calc(100vw - 32px)';
---

<article class:list={['project-preview', { compact }]}>
  <a class="image-link" href={getLocalizedPath(locale, `projects/${project.data.routeSlug}`)} tabindex="-1" aria-hidden="true">
    <Picture
      src={project.data.image.src}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[320, 480, 640, 800, 960, 1200]}
      sizes={sizes}
      quality={75}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="preview-copy">
    <p class="project-meta">
      <span>{project.data.category}</span>
      {project.data.year && <><span aria-hidden="true">·</span><span>{project.data.year}</span></>}
    </p>
    <h3><a href={getLocalizedPath(locale, `projects/${project.data.routeSlug}`)}>{project.data.title}</a></h3>
    <p class="description">{project.data.description}</p>
    <a class="arrow-link" href={getLocalizedPath(locale, `projects/${project.data.routeSlug}`)}>{copy.projects.readProject}</a>
  </div>
</article>

<style>
  .project-preview { display: grid; gap: var(--space-5); }
  .image-link { overflow: hidden; border-radius: var(--radius-md); background: var(--color-surface); }
  img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; transition: transform 300ms ease; }
  .project-preview:hover img { transform: scale(1.015); }
  .preview-copy { display: grid; gap: var(--space-3); }
  .project-meta { display: flex; color: var(--color-accent); font-size: var(--font-size-sm); font-weight: var(--font-weight-medium); gap: var(--space-2); }
  h3 { font-family: var(--font-display); font-size: var(--font-size-xl); font-weight: var(--font-weight-regular); }
  h3 a { color: var(--color-text); text-decoration: none; }
  h3 a:hover { color: var(--color-accent); }
  .description { color: var(--color-text-muted); }
  .arrow-link { justify-self: start; font-size: var(--font-size-sm); }
  .compact { padding-block: var(--space-5); border-block-start: var(--border-width) solid var(--color-border); }
  .compact .image-link { display: none; }
  .compact h3 { font-size: var(--font-size-lg); }
  @media (prefers-reduced-motion: reduce) { img { transition: none; } }
</style>
