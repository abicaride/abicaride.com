---
interface Props {
  labels: {
    system: string;
    light: string;
    dark: string;
  };
}

const { labels } = Astro.props;
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-label-system={labels.system}
  data-label-light={labels.light}
  data-label-dark={labels.dark}
  aria-label={labels.system}
  title={labels.system}
>
  <svg class="is-active" data-theme-icon="system" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="7.5" />
    <path d="M12 4.5a7.5 7.5 0 0 1 0 15z" />
  </svg>
  <svg data-theme-icon="light" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
    <circle cx="12" cy="12" r="3.75" />
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" />
  </svg>
  <svg data-theme-icon="dark" viewBox="0 0 24 24" aria-hidden="true" focusable="false" hidden>
    <path d="M19.2 15.1A8 8 0 0 1 8.9 4.8 8 8 0 1 0 19.2 15.1z" />
  </svg>
</button>

<script is:inline>
  (() => {
    const storageKey = 'abi-theme';
    const preferences = ['system', 'light', 'dark'];
    const root = document.documentElement;
    const control = document.querySelector('[data-theme-toggle]');

    if (!(control instanceof HTMLButtonElement)) return;

    const media = window.matchMedia('(prefers-color-scheme: dark)');

    const getStoredPreference = () => {
      const current = root.dataset.themePreference;
      if (preferences.includes(current)) return current;

      try {
        const stored = localStorage.getItem(storageKey);
        return preferences.includes(stored) ? stored : 'system';
      } catch {
        return 'system';
      }
    };

    const setControlState = (preference) => {
      const label = control.dataset[`label${preference[0].toUpperCase()}${preference.slice(1)}`];
      if (label) {
        control.setAttribute('aria-label', label);
        control.title = label;
      }

      control.querySelectorAll('[data-theme-icon]').forEach((icon) => {
        const isActive = icon.getAttribute('data-theme-icon') === preference;
        icon.classList.toggle('is-active', isActive);
        icon.toggleAttribute('hidden', !isActive);
      });
    };

    const applyPreference = (preference) => {
      const resolvedTheme = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
      root.dataset.themePreference = preference;
      root.dataset.theme = resolvedTheme;
      setControlState(preference);
    };

    const savePreference = (preference) => {
      try {
        localStorage.setItem(storageKey, preference);
      } catch {
        // The visual preference still works for this page when storage is unavailable.
      }
    };

    control.addEventListener('click', () => {
      const current = getStoredPreference();
      const next = preferences[(preferences.indexOf(current) + 1) % preferences.length];
      savePreference(next);
      applyPreference(next);
    });

    const followSystemPreference = () => {
      if (getStoredPreference() === 'system') applyPreference('system');
    };

    if (typeof media.addEventListener === 'function') media.addEventListener('change', followSystemPreference);
    else media.addListener(followSystemPreference);

    applyPreference(getStoredPreference());
  })();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    width: 2.75rem;
    min-width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    place-items: center;
    background: transparent;
    color: var(--color-green-deep);
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: var(--color-green-tint);
  }

  svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  svg:not(.is-active) {
    display: none;
  }

  svg[data-theme-icon='system'] path,
  svg[data-theme-icon='dark'] path {
    fill: currentColor;
    stroke: none;
  }

  :global(.site-header.overlay) .theme-toggle {
    color: var(--color-overlay-text);
    text-shadow: 0 1px 16px color-mix(in srgb, var(--color-overlay-shadow) 78%, transparent);
  }

  :global(.site-header.overlay) .theme-toggle:hover {
    background: color-mix(in srgb, var(--color-overlay-shadow) 28%, transparent);
  }

  :global(.site-header.overlay) .theme-toggle:focus-visible {
    outline-color: var(--color-overlay-text);
  }
</style>
