---
interface Props {
  labels: {
    light: string;
    dark: string;
  };
}

const { labels } = Astro.props;
---

<button
  class="theme-switch"
  type="button"
  role="switch"
  data-theme-toggle
  data-label-light={labels.light}
  data-label-dark={labels.dark}
  aria-checked="false"
  aria-label={labels.light}
  title={labels.light}
>
  <span class="switch-track" aria-hidden="true">
    <svg class="sun" viewBox="0 0 24 24" focusable="false">
      <circle cx="12" cy="12" r="3.5" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" />
    </svg>
    <svg class="moon" viewBox="0 0 24 24" focusable="false">
      <path d="M19.2 15.1A8 8 0 0 1 8.9 4.8 8 8 0 1 0 19.2 15.1z" />
    </svg>
    <span class="switch-thumb"></span>
  </span>
</button>

<script is:inline>
  (() => {
    const storageKey = 'abi-theme';
    const root = document.documentElement;
    const control = document.querySelector('[data-theme-toggle]');

    if (!(control instanceof HTMLButtonElement)) return;

    const media = window.matchMedia('(prefers-color-scheme: dark)');

    const readStoredPreference = () => {
      try {
        const stored = localStorage.getItem(storageKey);
        return stored === 'light' || stored === 'dark' ? stored : null;
      } catch {
        return null;
      }
    };

    let explicitPreference = readStoredPreference();

    const setControlState = (theme) => {
      const isDark = theme === 'dark';
      const label = isDark ? control.dataset.labelDark : control.dataset.labelLight;

      control.setAttribute('aria-checked', String(isDark));
      if (label) {
        control.setAttribute('aria-label', label);
        control.title = label;
      }
    };

    const applyTheme = (theme, source) => {
      root.dataset.theme = theme;
      root.dataset.themePreference = source === 'user' ? theme : 'system';
      setControlState(theme);
    };

    const savePreference = (theme) => {
      try {
        localStorage.setItem(storageKey, theme);
      } catch {
        // The explicit preference still works for this page when storage is unavailable.
      }
    };

    control.addEventListener('click', () => {
      const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      explicitPreference = nextTheme;
      savePreference(nextTheme);
      applyTheme(nextTheme, 'user');
    });

    const followSystemPreference = (event) => {
      if (explicitPreference === null) applyTheme(event.matches ? 'dark' : 'light', 'system');
    };

    if (typeof media.addEventListener === 'function') media.addEventListener('change', followSystemPreference);
    else media.addListener(followSystemPreference);

    const initialTheme = explicitPreference ?? (media.matches ? 'dark' : 'light');
    applyTheme(initialTheme, explicitPreference === null ? 'system' : 'user');
  })();
</script>

<style>
  .theme-switch {
    display: inline-grid;
    width: 4.75rem;
    min-width: 4.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    place-items: center;
    background: transparent;
    color: var(--color-green-deep);
    cursor: pointer;
  }

  .switch-track {
    position: relative;
    display: grid;
    width: 4.25rem;
    height: 2rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    grid-template-columns: repeat(2, 1fr);
    place-items: center;
    background: var(--color-surface);
  }

  .switch-thumb {
    position: absolute;
    z-index: 0;
    inset-block-start: 0.2rem;
    inset-inline-start: 0.2rem;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--color-green-deep);
    transition: transform 140ms ease;
  }

  .theme-switch[aria-checked='true'] .switch-thumb {
    transform: translateX(2.25rem);
  }

  svg {
    position: relative;
    z-index: 1;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .moon path {
    fill: currentColor;
    stroke: none;
  }

  .theme-switch[aria-checked='false'] .sun,
  .theme-switch[aria-checked='true'] .moon {
    color: var(--color-canvas);
  }

  .theme-switch:hover .switch-track {
    border-color: var(--color-green-deep);
  }

  :global(.site-header.overlay) .theme-switch {
    color: var(--color-overlay-text);
  }

  :global(.site-header.overlay) .switch-track {
    border-color: color-mix(in srgb, var(--color-overlay-text) 48%, transparent);
    background: color-mix(in srgb, var(--color-overlay-shadow) 52%, transparent);
  }

  :global(.site-header.overlay) .switch-thumb {
    background: var(--color-overlay-text);
  }

  :global(.site-header.overlay) .theme-switch[aria-checked='false'] .sun,
  :global(.site-header.overlay) .theme-switch[aria-checked='true'] .moon {
    color: var(--color-overlay-shadow);
  }

  :global(.site-header.overlay) .theme-switch:focus-visible {
    outline-color: var(--color-overlay-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .switch-thumb {
      transition: none;
    }
  }
</style>
