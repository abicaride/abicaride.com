---
import { getLocalizedPath, ui, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const currentYear = new Date().getFullYear();
const privacyPath = getLocalizedPath(locale, locale === 'en' ? 'privacy' : 'privacidad');
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-copy">
      <p class="footer-name">{copy.siteName}</p>
      <p>{copy.footer.note}</p>
    </div>
    <div class="footer-meta">
      <a href="mailto:abicaride@gmail.com">abicaride@gmail.com</a>
      <div class="footer-links">
        <a href={privacyPath}>{copy.footer.privacy}</a>
        <a href={privacyPath} data-cookie-settings>{copy.footer.cookieSettings}</a>
      </div>
      <p>© {currentYear}. {copy.footer.rights}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: var(--border-width) solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .footer-inner {
    display: flex;
    max-width: var(--size-content);
    margin-inline: auto;
    padding: var(--space-8) var(--space-page);
    gap: var(--space-2) var(--space-8);
    flex-wrap: wrap;
    justify-content: space-between;
  }

  .footer-copy,
  .footer-meta {
    display: grid;
    gap: var(--space-1);
  }

  .footer-name {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
  }

  .footer-meta {
    justify-items: start;
  }

  .footer-links {
    display: flex;
    gap: var(--space-2) var(--space-4);
    flex-wrap: wrap;
  }
</style>
