---
import { getLocalizedPath, languageNames, ui, type Locale } from '../i18n/config';
import brandMarkUrl from '../assets/brand/abilene-mark.svg?url';

interface Props {
  locale: Locale;
  currentLocalePath: string;
  alternateLocalePath: string;
}

const { locale, currentLocalePath, alternateLocalePath } = Astro.props;
const copy = ui[locale];
const currentYear = new Date().getFullYear();
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';
const privacyPath = getLocalizedPath(locale, locale === 'en' ? 'privacy' : 'privacidad');
const architecturePath = getLocalizedPath(locale, locale === 'en' ? 'architecture' : 'arquitectura');
---

<footer class="site-footer" style={`--brand-mark-image: url("${brandMarkUrl}")`}>
  <span class="brand-watermark" aria-hidden="true"></span>
  <div class="footer-inner">
    <div class="contact-close">
      <p class="footer-eyebrow">{copy.footer.eyebrow}</p>
      <h2>{copy.footer.heading}</h2>
      <a class="email" href="mailto:abicaride@gmail.com">abicaride@gmail.com <span aria-hidden="true">→</span></a>
    </div>
    <div class="utility">
      <div class="utility-groups">
        <div class="identity utility-group">
          <span class="identity-mark" aria-hidden="true"></span>
          <div>
            <p class="footer-name">{copy.siteName}</p>
            <p>{copy.footer.profession}</p>
          </div>
        </div>
        <nav class="utility-group" aria-labelledby="footer-privacy-title">
          <p class="utility-label" id="footer-privacy-title">{copy.footer.privacyLabel}</p>
          <div class="footer-links">
            <a href={privacyPath}>{copy.footer.privacy}</a>
            <a class="cookie-settings" href={privacyPath} data-cookie-settings>
              <span>{copy.footer.cookieSettings}</span>
              <svg class="settings-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4 7h10m4 0h2M4 17h2m4 0h10M14 4v6M10 14v6" />
              </svg>
            </a>
          </div>
        </nav>
        <nav class="utility-group" aria-labelledby="footer-language-title">
          <p class="utility-label" id="footer-language-title">{copy.footer.languageLabel}</p>
          <div class="locale-links">
            <a href={currentLocalePath} lang={locale} aria-current="page">
              <span class="visually-hidden">{languageNames[locale]}</span>{locale.toUpperCase()}
            </a>
            <a href={alternateLocalePath} lang={otherLocale} hreflang={otherLocale}>
              <span class="visually-hidden">{languageNames[otherLocale]}</span>{otherLocale.toUpperCase()}
            </a>
          </div>
        </nav>
        <div class="utility-group">
          <p class="utility-label">{copy.footer.buildLabel}</p>
          <a class="build-note" href={architecturePath} aria-label={copy.footer.buildDetails} title={copy.footer.buildDetails}>{copy.footer.buildNote} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="utility-meta">
        <p>© {currentYear} {copy.siteName}. {copy.footer.rights}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { position: relative; isolation: isolate; overflow: hidden; background: var(--color-footer); color: var(--color-footer-text); }
  .footer-inner { position: relative; z-index: 1; max-width: var(--size-wide); margin-inline: auto; padding: clamp(5rem, 10vw, 9rem) var(--space-page) var(--space-12); }
  .brand-watermark {
    position: absolute;
    z-index: 0;
    top: 19rem;
    right: -4.75rem;
    width: 13.5rem;
    aspect-ratio: 1;
    background: var(--color-footer-text);
    opacity: var(--opacity-footer-watermark);
    pointer-events: none;
    -webkit-mask: var(--brand-mark-image) center / contain no-repeat;
    mask: var(--brand-mark-image) center / contain no-repeat;
  }
  .contact-close { display: grid; max-width: 58rem; gap: var(--space-6); padding-block-end: clamp(5rem, 10vw, 8rem); }
  .footer-eyebrow { font-family: var(--font-heading); font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); letter-spacing: var(--letter-spacing-wide); text-transform: uppercase; }
  h2 { color: var(--color-footer-text); font-size: clamp(2.5rem, 2rem + 3vw, 5rem); }
  .email { display: inline-flex; min-height: 2.75rem; width: fit-content; align-items: center; gap: var(--space-2); color: var(--color-footer-text); font-family: var(--font-heading); font-size: clamp(1.15rem, 1rem + 0.55vw, 1.55rem); font-weight: var(--font-weight-semibold); text-decoration: none; }
  .email:hover { color: var(--color-footer-text); text-decoration: underline; text-underline-offset: .22em; }
  .utility { display: grid; padding-block-start: var(--space-10); border-block-start: var(--border-width) solid color-mix(in srgb, var(--color-burgundy-tint) 58%, transparent); gap: var(--space-8); color: color-mix(in srgb, var(--color-footer-text) 86%, transparent); font-size: var(--font-size-sm); }
  .utility-groups { display: grid; gap: var(--space-6); }
  .utility-group { display: grid; align-content: start; gap: var(--space-3); }
  .utility-group + .utility-group { padding-block-start: var(--space-6); border-block-start: var(--border-width) solid color-mix(in srgb, var(--color-burgundy-tint) 42%, transparent); }
  .utility-label { color: var(--color-footer-text); font-family: var(--font-heading); font-size: var(--font-size-xs); font-weight: var(--font-weight-semibold); letter-spacing: var(--letter-spacing-wide); text-transform: uppercase; }
  .identity { grid-template-columns: var(--space-12) minmax(0, 1fr); align-items: center; }
  .identity > div { display: grid; gap: var(--space-1); }
  .identity-mark {
    width: var(--space-12);
    aspect-ratio: 1;
    background: var(--color-footer-text);
    -webkit-mask: var(--brand-mark-image) center / contain no-repeat;
    mask: var(--brand-mark-image) center / contain no-repeat;
  }
  .footer-name { color: var(--color-footer-text); font-family: var(--font-heading); font-weight: var(--font-weight-semibold); }
  .footer-links { display: grid; justify-items: start; }
  .utility a { display: inline-flex; min-height: 2.75rem; align-items: center; color: inherit; }
  .utility a:hover { color: var(--color-footer-text); }
  .site-footer :focus-visible { outline-color: var(--color-footer-text); }
  .cookie-settings { gap: var(--space-2); text-decoration-style: dotted; }
  .settings-icon { width: var(--space-5); height: var(--space-5); fill: none; stroke: currentColor; stroke-linecap: round; stroke-width: 1.5; }
  .locale-links { display: flex; gap: var(--space-4); }
  .locale-links a { min-width: 2.75rem; justify-content: center; font-family: var(--font-heading); font-weight: var(--font-weight-medium); text-decoration: none; }
  .locale-links a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 0.12rem; text-underline-offset: 0.4rem; }
  .build-note { max-width: 28rem; text-decoration-style: dotted; }
  .utility-meta { padding-block-start: var(--space-8); border-block-start: var(--border-width) solid color-mix(in srgb, var(--color-burgundy-tint) 42%, transparent); color: color-mix(in srgb, var(--color-footer-text) 72%, transparent); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  @media (min-width: 56rem) {
    .brand-watermark { top: clamp(2.5rem, 5vw, 4.5rem); right: max(-3rem, calc((100vw - var(--size-wide)) / 2)); width: clamp(25rem, 34vw, 31rem); }
    .utility-groups { grid-template-columns: 1.35fr .82fr .55fr 1.35fr; gap: 0; }
    .utility-group { min-width: 0; padding-inline: var(--space-8); }
    .utility-group:first-child { padding-inline-start: 0; }
    .utility-group:last-child { padding-inline-end: 0; }
    .utility-group + .utility-group { padding-block-start: 0; border-block-start: 0; border-inline-start: var(--border-width) solid color-mix(in srgb, var(--color-burgundy-tint) 42%, transparent); }
  }

  @media (min-width: 40rem) and (max-width: 55.999rem) {
    .brand-watermark { top: 17rem; right: -6.5rem; width: 19rem; }
  }
</style>
